# .dockerignore racine — reduit drastiquement le contexte de build (sinon
# ~545 MB de target/ et coverage/ locaux sont copies a chaque build).
#
# IMPORTANT : ce fichier DOIT rester a la racine — Docker le lit depuis le
# contexte de build (= racine du repo, cf. context: ../.. dans compose).

# Rust
target/
**/target/
**/*.rs.bk
Cargo.lock.bak

# Node / build artifacts
node_modules/
**/node_modules/
dist/
**/dist/

# Git / IDE / outils locaux
.git/
.gitignore
.gitattributes
.github/
.vscode/
.idea/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docs / tests / coverage (pas necessaires aux builds)
docs/
*.md
!**/Cargo.toml
test-results/
coverage/
coverage-html/
*.log

# Env (jamais dans une image)
.env
.env.local
.env.*.local
.env.test

# AI artifacts (montes en volume au runtime, pas builds-in)
ai/training/checkpoints/
ai/training/*/checkpoints/
ai/training/*/datasets/

# Docker meta (les Dockerfiles eux-memes ne servent a rien dans le contexte)
docker-compose.yml
docker-compose.*.yml
infra/docker/docker-compose*.yml
**/Dockerfile

# Logos / assets non-builds
*.ico
*.png
!apps/web/public/**
!bots/sentinel-bot/assets/**
!infra/docker/empty-assets/**
