# Jeton partage uniquement entre atrium-bot et atrium-api (au moins 32 caracteres aleatoires).
ATRIUM_API_TOKEN=change-me-with-a-long-random-secret
# Cle fournie par DeepSeek. Ne jamais la commiter.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ATRIUM_API_BIND_ADDR=0.0.0.0:8090
ATRIUM_GRPC_BIND_ADDR=0.0.0.0:8091
# Debit soutenu par IP; une rafale de 10x est toleree par le limiteur commun.
ATRIUM_API_RATE_LIMIT_PER_SEC=5
# RAG : PostgreSQL doit disposer de pgvector. Les embeddings restent separes
# de DeepSeek et utilisent une API compatible OpenAI.
# Base dediee a Atrium (ne pas reutiliser discord_sentinel, SQLx partage
# `_sqlx_migrations` par base et Sentinel utilise deja une migration `001`).
ATRIUM_RAG_DATABASE_URL=postgres://atrium:change-me@127.0.0.1:5432/atrium
ATRIUM_EMBEDDINGS_BASE_URL=http://ollama:11434/v1
ATRIUM_EMBEDDINGS_API_KEY=
ATRIUM_EMBEDDINGS_MODEL=nomic-embed-text
