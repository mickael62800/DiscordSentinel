# Force les fins de ligne LF sur les scripts executes dans des conteneurs Linux.
# Sans ca, un clone sur Windows reecrit en CRLF et le shebang `#!/bin/sh\r`
# plante dans l'image alpine (`exec format error`).
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile text eol=lf

# Force LF sur les migrations SQL : sqlx::migrate calcule un checksum du
# fichier et le compare avec celui stocke en DB. Si CRLF/LF differe entre
# environnements (clone Windows -> deploy Linux), la migration deja
# appliquee panique avec VersionMismatch.
*.sql text eol=lf
*.rs text eol=lf
*.toml text eol=lf
