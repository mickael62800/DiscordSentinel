DATABASE_URL=postgres://sentinel:sentinel_secret@localhost:5432/discord_sentinel
REDIS_URL=redis://:sentinel_redis@localhost:6379
API_KEY=your_api_key_here
HOST=0.0.0.0
PORT=3000
RUST_LOG=sentinel_api=info,tower_http=debug

# RBAC global fail-closed gate (middleware/global_rbac.rs).
# Default false (no-op, aucun changement de comportement). Quand true, toute
# requete mutante (POST/PUT/PATCH/DELETE) d'un utilisateur web est gatee par
# role via la table ROUTE_ROLES ; les routes mutantes non mappees sont refusees
# (403, fail-closed). Les bots/workers (Bearer API_KEY) et le dev mode (API_KEY
# vide) passent toujours. A ACTIVER UNIQUEMENT APRES VALIDATION EN STAGING.
RBAC_GLOBAL_GATE=false
