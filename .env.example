# ── Infrastructure ──
POSTGRES_PASSWORD=sentinel_secret
REDIS_PASSWORD=sentinel_redis

# ── API Backend ──
API_KEY=your_api_key_here
# En dev local, mettre false pour desactiver l'obligation d'API_KEY
# En prod (Docker), laisser true (defaut) — l'API refuse de demarrer sans API_KEY
REQUIRE_API_KEY=false

# ── IA / Inference ONNX (optionnel) ──
VISION_MODEL_PATH=./models/vision_sentinel.onnx
TEXT_MODEL_PATH=./models/text_sentinel.onnx
TEXT_TOKENIZER_PATH=./models/tokenizer.json
TEXT_MAX_LENGTH=256

# ── Bots Discord (un token par bot) ──
AUTOMOD_DISCORD_TOKEN=your_automod_token
MODERATION_DISCORD_TOKEN=your_moderation_token
SECURITY_DISCORD_TOKEN=your_security_token
TICKET_DISCORD_TOKEN=your_ticket_token
IMAGE_DISCORD_TOKEN=your_image_bot_token
AUDIT_DISCORD_TOKEN=your_audit_token
PROGRESSION_DISCORD_TOKEN=your_progression_token
COMMUNITY_DISCORD_TOKEN=your_community_token
ROLES_DISCORD_TOKEN=your_roles_token
CLEANUP_DISCORD_TOKEN=your_cleanup_token
BLACKJACK_DISCORD_TOKEN=your_blackjack_token
COUDE_DISCORD_TOKEN=your_coude_token
GAME_DISCORD_TOKEN=your_game_token
WELCOME_DISCORD_TOKEN=your_welcome_token

# Voice bot — configuration specifique (IDs Discord du serveur cible)
VOICE_DISCORD_TOKEN=your_voice_token
VOICE_GUILD_ID=your_guild_id
VOICE_PUBLIC_CREATOR_CHANNEL_ID=your_public_creator_channel_id
VOICE_PRIVATE_CREATOR_CHANNEL_ID=your_private_creator_channel_id
VOICE_LOG_CHANNEL_ID=your_log_channel_id

# ── Monitoring (optionnel, profile "monitoring") ──
PGADMIN_EMAIL=admin@sentinel.local
PGADMIN_PASSWORD=admin
