# ── Infrastructure ──
POSTGRES_PASSWORD=sentinel_secret
REDIS_PASSWORD=sentinel_redis

# ── API Backend ──
API_KEY=your_api_key_here
# En dev local, mettre false pour desactiver l'obligation d'API_KEY
# En prod (Docker), laisser true (defaut) — l'API refuse de demarrer sans API_KEY
REQUIRE_API_KEY=false

# Discord user IDs (separes par virgule) autorises a acceder au back-office web.
# C'est le SEUL point d'entree humain : tout ID absent de la liste recoit un 403.
# FAIL-CLOSED — liste vide = personne n'entre (les services internes bot/worker
# continuent via API_KEY). A renseigner AVANT de deployer : le perdre verrouille
# le back-office (reparation par cette variable + redemarrage, plus par SQL).
SUPERADMIN_USER_IDS=

# ── IA / DeepSeek LLM Moderation & ONNX (optionnel) ──
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODERATION_MODEL=deepseek-chat
DEEPSEEK_MODERATION_ENDPOINT=https://api.deepseek.com/chat/completions
VISION_MODEL_PATH=./models/vision_sentinel.onnx
TEXT_MODEL_PATH=./models/text_sentinel.onnx
TEXT_TOKENIZER_PATH=./models/tokenizer.json
TEXT_MAX_LENGTH=256

# ── Bot Discord unifie ──
# Un seul token pour le sentinel-bot qui regroupe les 15 anciens bots
# (audit, automod, blackjack, cleanup, community, moderation,
# progression, security, tickets, voice, welcome). Reutilise aussi par l'API
# (fetch images Discord) et par les workers (audit sync).
SENTINEL_DISCORD_TOKEN=your_sentinel_bot_token

# ── Voice module (IDs Discord du serveur cible) ──
# Optionnel : si non defini, le module voice est desactive
VOICE_GUILD_ID=your_guild_id
VOICE_PUBLIC_CREATOR_CHANNEL_ID=your_public_creator_channel_id
VOICE_PRIVATE_CREATOR_CHANNEL_ID=your_private_creator_channel_id
VOICE_LOG_CHANNEL_ID=your_log_channel_id

# ── Tickets module (optionnel) ──
TICKET_CATEGORY_ID=
TICKET_CHANNEL_ID=

# ── Monitoring (optionnel, profile "monitoring") ──
PGADMIN_EMAIL=admin@sentinel.local
PGADMIN_PASSWORD=admin

# ── Web / TLS ──
# Domaine servi par nginx. Utilise :
#   - pour le CN du cert self-signed (dev) si aucun cert LE present
#   - pour retrouver le cert Let's Encrypt dans /etc/letsencrypt/live/<WEB_DOMAIN>/
# En dev local : laisser "localhost" (cert self-signed 30j auto-genere).
WEB_DOMAIN=localhost

# ── Site public ──
# Ces deux valeurs sont lues a l'EXECUTION par le conteneur web (ecrites dans
# site-config.json par l'entrypoint). Les changer ne demande donc qu'un
# redemarrage du conteneur, pas une reconstruction de l'image.

# Serveur Discord dont le site affiche la vie (planning, serveurs de jeu,
# recherche de joueurs, sondages...). SANS ELLE, l'espace membre n'affiche
# aucune section : il ne sait pas de quel serveur parler.
PUBLIC_GUILD_ID=

# Lien d'invitation Discord, affiche en bouton sur l'accueil et l'espace
# membre. Vide => le bouton n'apparait pas (un bouton qui ne mene nulle part
# est pire que pas de bouton). Seuls les liens https vers discord.gg /
# discord.com sont acceptes.
DISCORD_INVITE=

# URL de l'API injectee au build du SPA. Vide => fetch en relatif (proxy nginx).
# A definir uniquement si le front et l'API sont sur des domaines differents.
VITE_API_URL=

# Let's Encrypt — requis pour activer le service `certbot` (profile "tls")
# Usage : docker compose --profile tls up -d certbot
LETSENCRYPT_EMAIL=
# Mettre "1" pour utiliser l'env de staging LE (certs non trustables, pas de
# rate-limit). Vide/unset = prod.
LETSENCRYPT_STAGING=

# ── Plateforme jeux Nexus (nexus-api / nexus-bot / nexus-worker) ──
# Stack separee de Sentinel, lancee via son propre profile :
#   docker compose --profile nexus up -d
# Base `nexus` sur le MEME Postgres que Sentinel (creee par nexus-db-init).

# Token du bot Discord Nexus (distinct de SENTINEL_DISCORD_TOKEN).
NEXUS_DISCORD_TOKEN=
# Cle partagee API <-> bot <-> worker. Vide = /api SANS auth (dev uniquement).
NEXUS_API_KEY=

# Runtime des serveurs de jeu : noop | docker.
# noop (defaut) = aucun container reel. Passer a `docker` pour que game-portal
# cree vraiment les serveurs (necessite le socket Docker, deja monte sur
# nexus-api par le compose).
NEXUS_GAME_RUNTIME=noop

# GID du groupe `docker` de l'host (proprietaire de /var/run/docker.sock).
# A relever avec : stat -c '%g' /var/run/docker.sock
DOCKER_GID=988

# Cadence des jobs game-portal du worker (secondes). Defauts entre parentheses.
GAME_HEALTH_CHECK_INTERVAL_SECS=30
GAME_IDLE_SHUTDOWN_CHECK_INTERVAL_SECS=3600
GAME_RECONCILER_INTERVAL_SECS=3600
GAME_IMAGE_CLEANUP_INTERVAL_SECS=86400
GAME_REVEAL_IP_INTERVAL_SECS=300
GAME_DAILY_PING_INTERVAL_SECS=3600

# ── Nexus hors Docker (cargo run) ──
# Fournies par le compose en conteneur ; a definir seulement pour un run local.
#   NEXUS_DATABASE_URL=postgres://sentinel:<POSTGRES_PASSWORD>@localhost:5432/nexus
#   NEXUS_API_URL=http://localhost:3100
#   NEXUS_API_PORT=3100
#   REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379
#   GAME_PORTAL_PORT_RESERVATION_TTL_SECS=300

# Profils Docker actives par defaut, pour que `docker compose up -d` lance
# TOUT sans avoir a passer --profile a chaque fois.
# Valeurs possibles (separees par virgule) : nexus, monitoring, tls
COMPOSE_PROFILES=nexus
